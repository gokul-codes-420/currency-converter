# World Currency Converter Backend Environment Variables

PORT=5001
NODE_ENV=development

# Database Configuration (Optional - falls back seamlessly to in-memory store if not available)
# Example local: mongodb://127.0.0.1:27017/world_currency_converter
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/world_currency_converter?retryWrites=true&w=majority
MONGODB_URI=

# Optional: Custom Exchange Rate API URL override (defaults to https://open.er-api.com/v6/latest)
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest

# CORS Allowed Origins (comma-separated in production)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
